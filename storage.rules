rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userCompany() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function sameCompany(companyId) {
      return signedIn() && userCompany() == companyId;
    }

    match /reports/{companyId}/{reportId}/{allPaths=**} {
      allow read, write: if sameCompany(companyId);
    }

    match /company/{companyId}/{allPaths=**} {
      allow read, write: if sameCompany(companyId);
    }
  }
}
